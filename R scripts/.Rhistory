y = paste0("Average ", tolower(habitat_filter[i]), " sample completeness per recorder ± SE")
) +
scale_x_continuous(breaks = x_axis_breaks,
labels = x_axis_labels) +
theme_minimal(base_size = 14)
ggsave(paste0(local_path, "R plots/", stations$project_name[i], "/BirdNET/Global results/", tolower(habitat_filter[i]), "_sample_completeness_by_time_recorded_curve.jpg"), width = 4000, height = 2000, dpi = 300, units = "px", limitsize = FALSE, plot = pl)
}
ggsave(paste0(local_path, "R plots/", stations$project_name[i], "/Sample coverage/", tolower(habitat_filter[i]), "_sample_completeness_by_time_recorded_curve.jpg"), width = 4000, height = 2000, dpi = 300, units = "px", limitsize = FALSE, plot = pl)
for (i in 1:length(habitat_filter)) {
avg_accumulated_richness_per_station <- accumulated_richness_per_station %>%
left_join(stations %>%
select(station_name, recorder_location)) %>%
filter(habitat_filter[i] == "" | recorder_location == habitat_filter[i]) %>%
group_by(n_recordings, minimum_confidence_threshold, including_manual_detections) %>%
summarize(avg_accumulated_richness = mean(as.numeric(accumulated_richness)),
sd_accumulated_richness = sd(accumulated_richness),
se_accumulated_richness = sd_accumulated_richness / sqrt(n()),
avg_sample_coverage = mean(as.numeric(sample_coverage)),
sd_sample_coverage = sd(sample_coverage),
se_sample_coverage = sd_sample_coverage / sqrt(n()),
n_recorders = n()) %>%
mutate(n_recordings = as.numeric(n_recordings)) %>%
filter(n_recordings > 0,
n_recordings <= 14 * 24,
!is.na(sd_accumulated_richness),
!is.na(sd_sample_coverage))
x_axis_labels <- unique((avg_accumulated_richness_per_station %>%
arrange(n_recordings) %>%
filter(n_recordings %% 24 == 0) %>%
mutate(labels = paste0(as.character(n_recordings / 24), "\n(n=", n_recorders, ")")))$labels)
x_axis_breaks <- 24 * seq(1, length(x_axis_labels), 1)
# Plotting accumulated richness
pl <- ggplot(avg_accumulated_richness_per_station, aes(
x = n_recordings,
y = avg_accumulated_richness,
color = factor(minimum_confidence_threshold),
fill  = factor(minimum_confidence_threshold),
linetype = factor(including_manual_detections)
)) +
geom_ribbon(
aes(
ymin = avg_accumulated_richness - se_accumulated_richness,
ymax = avg_accumulated_richness + se_accumulated_richness,
group = interaction(minimum_confidence_threshold, including_manual_detections)
),
alpha = 0.15, color = NA
) +
geom_line(size = 1) +
scale_color_viridis_d(name = "Min. confidence\nthreshold") +
scale_fill_viridis_d(name = "Min. confidence\nthreshold") +
scale_linetype_manual(
name = "Including manual\ndetections",
values = c("FALSE" = "dashed", "TRUE" = "solid")
) +
labs(
x = "Number of days recorded",
y = paste0("Average accumulated ", tolower(habitat_filter[i]), " richness per recorder ± SE")
) +
scale_x_continuous(breaks = x_axis_breaks,
labels = x_axis_labels) +
theme_minimal(base_size = 14)
ggsave(paste0(local_path, "R plots/", stations$project_name[i], "/BirdNET/Global results/accumulated_", tolower(habitat_filter[i]), "_richness_curve.jpg"), width = 4000, height = 2000, dpi = 300, units = "px", limitsize = FALSE, plot = pl)
# Plotting sample coverage by time recorded
